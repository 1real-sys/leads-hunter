# Copie este arquivo para .env e preencha com os seus valores.
# O .env nao e versionado (veja .gitignore).
# Carregue antes de subir o backend: `set -a; source .env; set +a`

# Banco de dados MySQL
DB_USERNAME=leadhunter
DB_PASSWORD=

# Google Places API (New) - obrigatoria para POST /api/buscas
# Crie a sua propria chave no Google Cloud e habilite "Places API (New)".
GOOGLE_PLACES_API_KEY=

# Brave Search API - opcional, usada pela "Buscar informacoes" no historico
BRAVE_SEARCH_API_KEY=

# Ajustes opcionais
# GOOGLE_PLACES_RATE_LIMIT_REQUISICOES=10
# GOOGLE_PLACES_RATE_LIMIT_PERIODO_SEGUNDOS=60
# BUSCA_CACHE_EXPIRACAO_MINUTOS=30
# BUSCA_CACHE_TAMANHO_MAXIMO=100
# PESQUISA_BRAVE_HABILITADO=true
# PESQUISA_SCRAPING_HABILITADO=false
# PESQUISA_PAGINA_TIMEOUT_MS=10000
# PESQUISA_PAGINA_MAX_BYTES=524288
